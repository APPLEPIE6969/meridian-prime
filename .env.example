# ── Meridian Prime configuration ─────────────────────────────────────────────

# SQLite database file (created by `npm run db:push`).
# Prefer an absolute path outside the repo for real deployments:
#   DATABASE_URL="file:/var/lib/meridian-prime/prime.db"
DATABASE_URL="file:./prime.db"

# Operator desk passcode (web console login at /login).
# When unset the dev fallback is `meridian-desk-2026` — set your own before
# exposing the desk beyond localhost.
# MERIDIAN_OPERATOR_PASSCODE=change-me

# Market data provider: `yahoo` (live) or `fixture` (recorded payloads, for
# offline work and CI). Live is the default; fixture mode is used automatically
# by the unit suites.
MERIDIAN_DATA_PROVIDER=yahoo

# Quote poll cadence in milliseconds, and how many symbols get a fresh
# intraday minute-series refresh per poll cycle (round-robin).
MERIDIAN_POLL_INTERVAL_MS=5000
MERIDIAN_MINUTE_REFRESH=8

# Optional Socket.IO relay (mini-services/relay) for live console streaming.
# Leave MERIDIAN_RELAY_URL empty to run the desk without the relay.
MERIDIAN_RELAY_URL=
MERIDIAN_RELAY_TOKEN=prime-relay
NEXT_PUBLIC_RELAY_URL=http://localhost:3003

# Log level: debug | info | warn | error
MERIDIAN_LOG_LEVEL=info
