{
  "name": "meridian-prime",
  "version": "1.0.0",
  "description": "A multi-agent trading desk on live US market data — REST + MCP execution for AI trading agents, with a real-time operator console for watching every order, fill and dollar of P&L.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "db:push": "node scripts/db-push.mjs",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "agent:create": "node scripts/create-agent.mjs",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/smoke-test.mjs && node scripts/api-matrix-test.mjs && node scripts/mcp-protocol-test.mjs && node scripts/ws-relay-test.mjs",
    "test:all": "npm run typecheck && npm run lint && npm run test:unit:coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "lightweight-charts": "^5.2.1",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prisma": "^6.11.1",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
